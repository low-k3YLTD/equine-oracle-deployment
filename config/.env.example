# OAuth Configuration
OAUTH_SERVER_URL=https://your-oauth-server.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-server.com/portal
VITE_APP_ID=your_app_id_here

# Database Configuration (if using a live database)
DATABASE_URL=mysql://user:password@host:port/database

# Owner Configuration (for admin user)
OWNER_OPEN_ID=admin-user-equine-oracle-001

# Environment
NODE_ENV=production
